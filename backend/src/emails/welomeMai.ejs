<!DOCTYPE html>
<html>
  <body
    style="
      margin: 0;
      padding: 0;
      background: #f1f5f9;
      font-family: Arial, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f1f5f9">
      <tr>
        <td align="center" style="padding: 40px 0">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            bgcolor="#ffffff"
            style="
              border-radius: 12px;
              border: 1px solid #e2e8f0;
              padding: 40px;
            "
          >
            <!-- Header -->
            <tr>
              <td align="center">
                <div
                  style="
                    background: #2563eb;
                    color: white;
                    width: 40px;
                    height: 40px;
                    border-radius: 8px;
                    line-height: 40px;
                    font-weight: bold;
                    font-size: 20px;
                  "
                >
                  P
                </div>
                <h1 style="margin-top: 15px; font-size: 24px; color: #1e293b">
                  Welcome to ProManage
                </h1>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td
                style="
                  padding-top: 20px;
                  color: #1e293b;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                <h2>Hello, <%= name %></h2>

                <p>
                  We're excited to have you join <strong>ProManage</strong>! To
                  complete your registration, please verify your email address
                  using the OTP below:
                </p>

                <div style="text-align: center; margin: 30px 0">
                  <span
                    style="
                      font-size: 28px;
                      letter-spacing: 8px;
                      font-weight: 700;
                      background: #f1f5f9;
                      padding: 14px 26px;
                      border-radius: 8px;
                      color: #2563eb;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <p>
                  This OTP is valid for <strong>10 minutes</strong>. Please do
                  not share it with anyone.
                </p>

                <p
                  style="
                    font-size: 13px;
                    color: #94a3b8;
                    border-top: 1px solid #f1f5f9;
                    padding-top: 20px;
                  "
                >
                  If you did not create a ProManage account, you can safely
                  ignore this email.
                </p>

                <p style="margin-top: 25px">
                  Best regards,<br />
                  The ProManage Team
                </p>
              </td>
            </tr>
          </table>

          <!-- Footer -->
          <table width="600" cellpadding="0" cellspacing="0">
            <tr>
              <td
                align="center"
                style="padding: 20px; font-size: 14px; color: #64748b"
              >
                © 2026 ProManage Inc. All rights reserved.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
